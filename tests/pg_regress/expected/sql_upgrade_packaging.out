create extension if not exists pg_wal_budget;
select
  pg_get_constraintdef(oid) like '%queue%' as installed_policy_mode_allows_queue
from pg_constraint
where conrelid = 'pwb.policy'::regclass
  and conname = 'policy_mode_check';
 installed_policy_mode_allows_queue 
------------------------------------
 t
(1 row)

create temp table pwb_policy_mode_upgrade_test (
  mode text not null,
  constraint policy_mode_check
    check (mode in ('off', 'observe', 'shadow', 'reject'))
);
insert into pwb_policy_mode_upgrade_test (mode)
values ('off'), ('observe'), ('shadow'), ('reject');
alter table pwb_policy_mode_upgrade_test
  drop constraint policy_mode_check;
alter table pwb_policy_mode_upgrade_test
  add constraint policy_mode_check
  check (mode in ('off', 'observe', 'shadow', 'reject', 'queue'));
insert into pwb_policy_mode_upgrade_test (mode)
values ('queue');
select
  count(*) = 1 as migrated_policy_mode_allows_queue
from pwb_policy_mode_upgrade_test
where mode = 'queue';
 migrated_policy_mode_allows_queue 
-----------------------------------
 t
(1 row)

